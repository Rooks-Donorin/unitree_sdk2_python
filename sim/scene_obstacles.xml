<!-- Flat, lightweight scene (no shadows/reflections) with things for the simulated lidar to see:
     pillars, boxes, a low ledge and walls. Obstacles are in geom group 0, which sim_lidar.py scans. -->
<mujoco model="go2 scene obstacles">
  <include file="go2.xml"/>

  <statistic center="0 0 0.1" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
    <quality shadowsize="0" offsamples="0"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="32" height="192"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="128" height="128"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" castshadow="false"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <!-- obstacles (all in geom group 0, which the simulated lidar scans) -->
    <geom name="pillar1" type="cylinder" pos="2.0 0.4 0.5" size="0.15 0.5" rgba="0.8 0.4 0.3 1"/>
    <geom name="pillar2" type="cylinder" pos="3.5 -1.2 0.5" size="0.10 0.5" rgba="0.8 0.4 0.3 1"/>
    <geom name="box1" type="box" pos="3.0 1.6 0.25" size="0.4 0.3 0.25" rgba="0.5 0.7 0.4 1"/>
    <geom name="ledge" type="box" pos="1.0 -1.0 0.05" size="0.3 0.6 0.05" rgba="0.5 0.7 0.4 1"/>
    <geom name="wall_front" type="box" pos="5.5 0 0.5" size="0.05 3.0 0.5" rgba="0.6 0.6 0.7 1"/>
    <geom name="wall_left" type="box" pos="2.5 3.0 0.5" size="3.05 0.05 0.5" rgba="0.6 0.6 0.7 1"/>
    <geom name="wall_right" type="box" pos="2.5 -3.0 0.5" size="3.05 0.05 0.5" rgba="0.6 0.6 0.7 1"/>
  </worldbody>
</mujoco>
